# Скопируй в .env и поправь под себя
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000
# Адрес сайта без слэша в конце (для canonical, sitemap, Open Graph)
SITE_URL=http://127.0.0.1:8000
SITE_TIMEZONE=Europe/Moscow
# Путь к базе относительно корня проекта или абсолютный
DATABASE_PATH=data/app.db
UPLOAD_DIR=uploads
# Включает поле видео в админке и плеер на странице записи
VIDEO_ENABLED=false
